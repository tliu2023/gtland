# Copy to .env in the repo root on the server and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32
# Use hex/alphanumeric passwords: STOREFRONT_DB_PASSWORD is embedded in a connection URL.

# Public domain (DNS A record must point at this server)
DOMAIN=gtland.example.com

# Database
POSTGRES_DB=gtland
POSTGRES_USER=gtland_admin
POSTGRES_PASSWORD=
STOREFRONT_DB_USER=gtland_readonly
STOREFRONT_DB_PASSWORD=

# Django
DJANGO_SECRET_KEY=

# Email (verification emails + contact form). Google Workspace: smtp.gmail.com + an app password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=gtland <no-reply@gtland.example.com>
# Where contact-form messages are delivered
CONTACT_EMAIL=
